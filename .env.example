# Existing Navidrome instance (OpenSubsonic API)
NAVIDROME_URL=http://192.168.1.10:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=changeme

# Snapcast (defaults work with network_mode: host)
SNAPCAST_HOST=127.0.0.1
SNAPCAST_CONTROL_PORT=1705
SNAPCAST_TCP_PORT=4953

# Hub web UI (8188 avoids other apps that already use 8080)
HUB_HOST=0.0.0.0
HUB_PORT=8188

# Optional: pre-register Pi pairing UIs for the Services panel
# MULTIROOM_AGENTS=Living|http://10.0.0.20:8190,Kitchen|http://10.0.0.21:8190
